ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contablytask_development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Use um projeto e um bucket exclusivos para este ambiente.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=documentos-contablytask-development

ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Formulário público de contato
TURNSTILE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=contato@contablytask.com.br

# Alertas automáticos de vencimento
ALERT_FROM_EMAIL=
ALERT_REPLY_TO=
# Gere um valor aleatório com pelo menos 32 caracteres.
ALERT_CRON_SECRET=

# Reconciliação automática das tarefas recorrentes
# Use um segredo diferente do processador de alertas.
RECURRENCE_CRON_SECRET=

# Processamento pendente e conciliação periódica com o Asaas
ASAAS_RECONCILIATION_SECRET=
